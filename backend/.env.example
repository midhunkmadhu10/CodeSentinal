# CodeSentinal backend configuration
# Copy to .env and fill in real values. The backend fails closed: protected
# routes and login refuse to work while any required variable below is empty.
# NEVER commit the real .env file.

# Required — login credentials for the web UI. Choose strong values.
AUTH_USERNAME=
AUTH_PASSWORD=

# Required — legacy static bearer token accepted alongside JWT tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=

# Required — HS256 signing key for JWT access tokens. Without it a random
# per-process secret is used, so tokens stop working after a restart.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Required — OpenAI-compatible LLM configuration. The key stays server-side.
LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=

# Database. Leave unset for the zero-config SQLite fallback (local dev/CI).
# Postgres needs the psycopg driver, which the URL selects explicitly.
# DATABASE_URL=postgresql+psycopg://codesentinal:codesentinal@localhost:5432/codesentinal
# EMBEDDING_DIM=768

# Optional — embeddings for repository RAG (falls back to TF-IDF when unset).
# EMBEDDINGS_ENDPOINT=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small

# Optional — model routing. Both tiers default to LLM_MODEL.
# MODEL_FAST=
# MODEL_DEEP=
# DEEP_TIER_THRESHOLD=0.55
# MODEL_COST_FAST_IN=0.10
# MODEL_COST_FAST_OUT=0.40
# MODEL_COST_DEEP_IN=1.25
# MODEL_COST_DEEP_OUT=5.00

# Optional — GitHub automation (private repo indexing, PR comments, webhooks).
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=

# Optional — background worker (indexing + webhook reviews).
# WORKER_ENABLED=true
# WORKER_CONCURRENCY=2
# WORKER_POLL_SECONDS=1.0
# JOB_MAX_ATTEMPTS=3

# Optional — generic tuning.
# LOG_LEVEL=INFO
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_TOKENS=4096
# JWT_EXPIRES_HOURS=12
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
