# CodeSentinal backend configuration
# Copy to .env and fill in real values. The backend fails closed: protected
# routes and login refuse to work while any required variable below is empty.
# NEVER commit the real .env file.

# Required — login credentials for the web UI. Choose strong values.
AUTH_USERNAME=
AUTH_PASSWORD=

# Required — bearer token issued at login and required by protected API routes.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=

# Required — OpenAI-compatible LLM configuration. The key stays server-side.
LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=

# Optional
# LOG_LEVEL=INFO
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_TOKENS=4096
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
